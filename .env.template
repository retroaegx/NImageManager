# NImageManager 設定テンプレート
# NImageManager environment template
# このファイルを ".env" にコピーして使います。
# Copy this file to ".env" before editing.

# 公開用URL
# Public base URL
# 設定すると Quick Tunnel は使いません。
# When this is set, Quick Tunnel is not used.
# 例: https://your-domain.example.com
# Example: https://your-domain.example.com
NAI_IM_PUBLIC_BASE_URL=

# フォルダ監視による自動取り込み
# Auto-import from watched folder
# 1: ON / 0: OFF
NAI_IM_DROP_IMPORT_ENABLED=1

# 監視フォルダ
# Watched folder path
# 相対パス例: ./input_image
# Relative example: ./input_image
# Windows絶対パス例: D:/NImageManager/input_image
# Windows absolute example: D:/NImageManager/input_image
# Linux絶対パス例: /opt/NImageManager/input_image
# Linux absolute example: /opt/NImageManager/input_image
NAI_IM_DROP_IMPORT_DIR=./input_image

# 配置後に待つ秒数
# Seconds to wait after a file appears before import starts
NAI_IM_DROP_IMPORT_SETTLE_SEC=3

# 監視する深さ
# Depth to watch
# 0 = 指定フォルダ直下のみ
# 0 = only the target folder itself
# 1 = 直下 + 1階層下
# 1 = target folder + one level below
# 2 = 直下 + 2階層下
# 2 = target folder + two levels below
NAI_IM_DROP_IMPORT_MAX_DEPTH=1

# パフォーマンスログ
# Performance log
# 1: ON / 0: OFF
NAI_IM_PERF_LOG_ENABLED=0

# パフォーマンスログのローテーション設定
# Performance log rotation
NAI_IM_PERF_LOG_MAX_BYTES=5242880
NAI_IM_PERF_LOG_BACKUP_COUNT=5

# SQLite の busy timeout（ミリ秒）
# SQLite busy timeout in milliseconds
NAI_IM_SQLITE_BUSY_TIMEOUT_MS=10000
NAI_IM_QUEUE_SQLITE_BUSY_TIMEOUT_MS=10000

# 一般ユーザーのアップロード容量上限（バイト）
# Default upload storage limit for regular users (bytes)
# 5368709120 = 5 GiB / 0 = unlimited
NAI_IM_USER_UPLOAD_LIMIT_BYTES=5368709120

# 派生画像設定
# Derived image settings
# grid: 一覧用サムネイル
# grid: gallery thumbnail
# overlay: ビューア用画像
# overlay: viewer image
# WEBP method: 0=最速 / 6=最小
# WEBP method: 0=fastest / 6=smallest
# AVIF speed: 0=最遅 / 10=最速
# AVIF speed: 0=slowest / 10=fastest
# AVIF codec: auto / aom / rav1e / svt
# AVIF max threads: 0 は Pillow 既定値
# AVIF max threads: 0 means Pillow default
NAI_IM_DERIV_GRID_MAX_SIDE=320
NAI_IM_DERIV_GRID_WEBP_QUALITY=70
NAI_IM_DERIV_GRID_WEBP_METHOD=4
NAI_IM_DERIV_GRID_WEBP_LOSSLESS=0
NAI_IM_DERIV_GRID_WEBP_ALPHA_QUALITY=80
NAI_IM_DERIV_GRID_AVIF_ENABLED=1
NAI_IM_DERIV_GRID_AVIF_QUALITY=70
NAI_IM_DERIV_GRID_AVIF_SPEED=8
NAI_IM_DERIV_GRID_AVIF_CODEC=auto
NAI_IM_DERIV_GRID_AVIF_MAX_THREADS=0

NAI_IM_DERIV_OVERLAY_MAX_SIDE=1400
NAI_IM_DERIV_OVERLAY_WEBP_QUALITY=82
NAI_IM_DERIV_OVERLAY_WEBP_METHOD=4
NAI_IM_DERIV_OVERLAY_WEBP_LOSSLESS=0
NAI_IM_DERIV_OVERLAY_WEBP_ALPHA_QUALITY=92
NAI_IM_DERIV_OVERLAY_AVIF_ENABLED=1
NAI_IM_DERIV_OVERLAY_AVIF_QUALITY=82
NAI_IM_DERIV_OVERLAY_AVIF_SPEED=8
NAI_IM_DERIV_OVERLAY_AVIF_CODEC=auto
NAI_IM_DERIV_OVERLAY_AVIF_MAX_THREADS=0

# 更新確認
# Update check
# 1: ON / 0: OFF
NAI_IM_UPDATE_CHECK_ENABLED=1

# 更新確認の間隔（時間）
# Update check interval in hours
NAI_IM_UPDATE_CHECK_INTERVAL_HOURS=24

# 更新確認対象の GitHub リポジトリ
# GitHub repository used for update check
# owner/repo 形式 または GitHub URL
# owner/repo format or GitHub URL
NAI_IM_UPDATE_REPO=retroaegx/NImageManager

# 拡張機能用の権限許可設定
# Extension cookie policy
NAI_IM_COOKIE_SECURE=1
NAI_IM_COOKIE_SAMESITE=none

# 公開ユーザー登録・メール確認・パスワード再設定
# Public registration, email verification, and password reset
NAI_IM_SMTP_HOST=
NAI_IM_SMTP_PORT=587
NAI_IM_SMTP_STARTTLS=1
NAI_IM_SMTP_USERNAME=
NAI_IM_SMTP_PASSWORD=
NAI_IM_SMTP_FROM=
NAI_IM_SMTP_FROM_NAME=NImageManager運営

# Google Identity Services
# Google login is shown only when this value is set.
NAI_IM_GOOGLE_CLIENT_ID=
